# Copy to backend/.env and adjust. Never commit real secrets.
ENV=development
# SQLite by default; for PostgreSQL: postgresql+psycopg://user:pass@localhost/finsight
DATABASE_URL=sqlite:///./finsight.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120
FRONTEND_ORIGIN=http://localhost:5173

# Optional: enables generative answers in the AI assistant (Anthropic Claude API).
# Leave empty to use the built-in offline assistant.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
